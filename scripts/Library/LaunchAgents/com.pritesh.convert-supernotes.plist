<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.pritesh.convert-supernotes</string>
    <key>ServiceDescription</key>
    <string>Converts supernote files to pdfs on change</string>
    <key>Program</key>
    <string>/Users/pritesh/.local/bin/convert-supernotes</string>
    <key>WatchPaths</key>
    <array>
      <string>/Users/pritesh/Notes/supernote/Note</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>NOTIFY</key>
      <string>/Users/pritesh/.local/bin/notify</string>
    </dict>
  </dict>
</plist>
