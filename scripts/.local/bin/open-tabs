#!/usr/bin/env -S cargo +nightly -Zscript -q
---cargo
[package]
edition = "2024"

[dependencies]
serde_json = "*"
---

use std::{collections::HashMap, env, error::Error, fs, process::Command};

const CONFIG_FILE: &str = "/Users/pritesh/.local/bin/tabs-config.json";

fn main() -> Result<(), Box<dyn Error>> {
    let cfg: HashMap<String, Vec<String>> = serde_json::from_slice(&fs::read(CONFIG_FILE)?)?;
    let key = env::args().nth(1).ok_or("no option")?;

    let mut sites = cfg
        .get(&key)
        .ok_or_else(|| {
            format!(
                "expected one of [{}]",
                cfg.keys().cloned().collect::<Vec<_>>().join(" | ")
            )
        })?
        .iter();

    Command::new("firefox")
        .args(["--new-window", sites.next().ok_or("no site found")?])
        .args(sites.flat_map(|s| ["--new-tab", s]))
        .spawn()?;

    Ok(())
}
