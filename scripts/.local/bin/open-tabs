#!/usr/bin/env -S cargo +nightly -Zscript -q
---cargo
[package]
edition = "2024"

[dependencies]
serde_json = "*"
---
//! Open a set of browser tabs based on config
//!
//! Example Config:
//! ```json
//! work: ["https://work-site.com", "https://mail.work.com"]
//! ```
//!
//! Usage:
//! ```bash
//! open-tabs work
//! ```

use std::{
    collections::HashMap,
    env::{self, home_dir},
    error::Error,
    fs,
    process::Command,
};

fn main() -> Result<(), Box<dyn Error>> {
    let config_file = home_dir()
        .ok_or("no home dir found")?
        .join(".local/bin/open-tabs-config.json");
    let cfg: HashMap<String, Vec<String>> = serde_json::from_slice(&fs::read(config_file)?)?;
    let key = env::args().nth(1).ok_or("no option")?;

    let mut sites = cfg
        .get(&key)
        .ok_or_else(|| {
            format!(
                "expected one of [{}]",
                cfg.keys().cloned().collect::<Vec<_>>().join(" | ")
            )
        })?
        .iter();

    Command::new("firefox")
        .args(["--new-window", sites.next().ok_or("no site found")?])
        .args(sites.flat_map(|s| ["--new-tab", s]))
        .spawn()?;

    Ok(())
}

// vi: ft=rust
