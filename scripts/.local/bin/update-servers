#!/usr/bin/env bash

servers=(toronto-server badass-server helsinki-server)

for server in ${servers[*]}; do
(
echo "Updating $server..."
ssh $server 'bash -s' <<'EOF'
for app in */; do pushd $app; docker compose pull --quiet && docker compose up -d; popd; done
docker system prune --all --volumes --force
sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && sudo reboot -h now
EOF
) &
done

wait

echo -e "\n\nDone!"
