#!/usr/bin/env -S cargo +nightly -Zscript --quiet
---cargo
[package]
edition = "2024"
[dependencies]
regex = "*"
ureq = { version = "*", features = ["json"] }
---
//! This program parses plain text files with specific line tags like `fr:` and `en:`,
//! which it uses to generate tts audio, each chunk by specific language.
//!
//! Example:
//! ```plain
//! // test_file.txt
//! fr: Bonjour en: Good Day
//! ```
//!
//! Usage:
//! ```bash
//! lang-parser test_file.txt # outputs test_file.mp3
//! ```
//!
//! Note:
//! Uses kokoro/piper tts engines on [talk-it-out](https://github.com/p-tupe/talk-it-out) to generate audio.

#![feature(hash_map_macro)]
use std::{env, fs, hash_map, path::PathBuf, process::Command};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    // TODO: Make const, or user configurable
    let lang_tag = hash_map! {
      "fr:" => "fr-fr",
      "en:" => "en-us",
    };
    // TODO: Build up from lang_tag
    let tags = regex::regex!("(?m)(fr:|en:)");

    let input_path = env::args().nth(1).ok_or("no file path in args")?;
    let input_file = fs::read_to_string(&input_path)?;

    let short_silence = "/tmp/short_silence.mp3";
    let long_silence = "/tmp/long_silence.mp3";
    if !fs::exists(short_silence)? {
        generate_silence(2, short_silence);
    }
    if !fs::exists(long_silence)? {
        generate_silence(3, long_silence);
    }

    let mut indices = tags.find_iter(&input_file).peekable();
    let mut flip = true; // for short/long silence
    let mut count = 0; // for chunk idx
    let mut chunks_list = String::from("file /tmp/short_silence.mp3\n");

    while let Some(curr) = indices.next() {
        let next = indices.peek().map_or(input_file.len(), |i| i.start());

        let mut resp = ureq::get("http://localhost:8001/tts")
            .query_pairs([
                ("lang", lang_tag.get(curr.as_str()).unwrap()),
                ("text", &input_file[curr.end()..next].trim()),
            ])
            .call()?;

        let chunk_path = format!("/tmp/chunk-{count}.mp3");
        fs::write(&chunk_path, resp.body_mut().read_to_vec()?)?;

        let silence = if flip { short_silence } else { long_silence };
        chunks_list.push_str(&format!("file {}\nfile {}\n", chunk_path, silence));

        flip = !flip;
        count += 1;
    }

    fs::write("/tmp/chunks_list.txt", chunks_list)?;

    Command::new("ffmpeg")
        .args(["-nostdin", "-hide_banner"])
        .args(["-loglevel", "error"])
        .args(["-f", "concat", "-safe", "0", "-i", "/tmp/chunks_list.txt"])
        .args(["-b:a", "128k"])
        .arg(PathBuf::from(&input_path).with_extension("mp3"))
        .output()?;

    Ok(())
}

fn generate_silence(time: i32, file: &str) {
    Command::new("ffmpeg")
        .args(["-nostdin", "-hide_banner"])
        .args(["-loglevel", "error", "-f", "lavfi"])
        .args(["-i", "anullsrc=r=22050:cl=mono"])
        .args(["-t", &time.to_string()])
        .args(["-c:a", "libmp3lame"])
        .args(["-b:a", "128k", "-ar"])
        .args(["22050", "-ac", "1"])
        .arg(file)
        .spawn()
        .expect("should generate silence");
}

